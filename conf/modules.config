/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    tag = { meta.containsKey('id') ? meta.id : [meta.species, meta.subtype].findAll().join(' ') }

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
    ]

    // SUBWORKFLOW: PREPARE
    withName: FASTERQDUMP {
        ext.args = '-S'
        publishDir = [
            path: { "${params.outdir}/sample/${meta.id}/reads/" },
            pattern: "*.fastq.gz"
        ]
    }    
    withName: 'SEQTK_SAMPLE' {
        ext.args = "-s11"
        publishDir = [
            path: { "${params.outdir}/sample/${meta.id}/reads/" },
            pattern: "*.fastq.gz"
        ]
    }
    withName: FASTQC {
        ext.args = '--quiet'
        publishDir = [ enabled: false ]
    }
    withName: 'FASTP' {
        ext.args = ""
        publishDir = [
            [ pattern: "*.fastq.gz", path: { "${params.outdir}/sample/${meta.id}/reads/" } ],
            [ pattern: "*.json", path: { "${params.outdir}/sample/${meta.id}/qc/" } ]  
        ]
    }

    // SUBWORKFLOW: CLASSIFY
    withName: 'SHOVILL' {
        container = 'biocontainers/shovill:1.4.2--hdfd78af_0'
        ext.args = "--assembler ${params.assembler} --depth ${params.shovill_depth} --mincov ${params.min_contig_cov} --minlen ${params.min_contig_len} --nocorr --tmpdir ./tmp"
        publishDir = [
            path: { "${params.outdir}/sample/${meta.id}/classify/" },
            pattern: "contigs.fa",
            saveAs: {"${meta.id}.denovo.fa"},
        ]
    }
    withName: 'GAMBIT_QUERY' {
        ext.args = ""
        stageInMode = 'copy'
        publishDir = [
            path: { "${params.outdir}/sample/${meta.id}/classify/" },
            pattern: "*_gambit.csv"
        ]
    }
    withName: 'SUBTYPE_SKETCH' {
        container = 'public.ecr.aws/o8h2f0o1/corgisnps:1.0'
        stageInMode = 'copy'
        ext.args = ""
        publishDir = [
            path: { "${params.outdir}/species/${meta.id}/subtype_model/" },
            pattern: "*.zip"
        ]
    }
    withName: 'SUBTYPE' {
        container = 'public.ecr.aws/o8h2f0o1/corgisnps:1.0'
        stageInMode = 'copy'
        ext.args = ""
        publishDir = [
            path: { "${params.outdir}/sample/${meta.id}/classify/" },
            pattern: "*_subtype.csv"
        ]
    }

    // -------------------------------------------------------------------------
    // SUBWORKFLOW: VARIANTS  (runs twice: standalone and inside AMR)
    //   - Standalone VARIANTS:*           -> ${outdir}/variants/<sample>/
    //   - Inside AMR (AMR:VARIANTS:*)     -> ${outdir}/amr_variants/<sample>/
    // -------------------------------------------------------------------------

    // ALIGN_READS
    withName: 'ALIGN_READS' {
        ext.args = ""
        publishDir = [ 
            path: { 
                task.process.contains('AMR') ? 
                    "${params.outdir}/sample/${meta.id}/amr/aln" : 
                    "${params.outdir}/sample/${meta.id}/variants/aln" 
            },
            pattern: "*.bam*"
        ]    
    }

    // SAMTOOLS_MPILEUP
    withName: 'SAMTOOLS_MPILEUP' {
        ext.args = "-aa -d ${params.limit_coverage}"
        publishDir = [ 
            path: { 
                task.process.contains('AMR') ? 
                    "${params.outdir}/sample/${meta.id}/amr/lowsites" : 
                    "${params.outdir}/sample/${meta.id}/variants/lowsites" 
            },
            pattern: "*.mpileup.gz"
        ]    
    }

    // LOWSITES
    withName: 'LOWSITES' {
        container = 'public.ecr.aws/o8h2f0o1/corgisnps:1.0'
        ext.args = ""
        publishDir = [ 
            path: { 
                task.process.contains('AMR') ? 
                    "${params.outdir}/sample/${meta.id}/amr/lowsites" : 
                    "${params.outdir}/sample/${meta.id}/variants/lowsites" 
            },
            pattern: "*.{csv,bed}"
        ]    
    }

    withName: 'FREEBAYES' {
        ext.args = { "--ploidy ${meta.ploidy} --limit-coverage ${params.limit_coverage}" }
        publishDir = [ 
            path: { 
                task.process.contains('AMR') ? 
                    "${params.outdir}/sample/${meta.id}/amr/vcf" : 
                    "${params.outdir}/sample/${meta.id}/variants/vcf" 
            },
            pattern: "*.vcf.gz"

        ]
    }

    // FILTER_VCF
    withName: 'FILTER_VCF' {
        ext.args = ""
        publishDir = [ 
            path: { 
                task.process.contains('AMR') ? 
                    "${params.outdir}/sample/${meta.id}/amr/vcf" : 
                    "${params.outdir}/sample/${meta.id}/variants/vcf" 
            }, 
            pattern: "*.vcf.gz"
        ]    
    }

    // CREATE_MASK
    withName: 'CREATE_MASK' {
        container = 'staphb/bedtools:2.31.1'
        ext.args = ""
        publishDir = [ 
            path: { 
                task.process.contains('AMR') ? 
                    "${params.outdir}/sample/${meta.id}/amr/vcf" : 
                    "${params.outdir}/sample/${meta.id}/variants/vcf" 
            },
            pattern: "*.bed"
        ]    
    }

    // BCFTOOLS_CONSENSUS
    withName: 'BCFTOOLS_CONSENSUS' {
        ext.args = "--iupac-codes"
        publishDir = [ 
            path: { 
                task.process.contains('AMR') ? 
                    "${params.outdir}/sample/${meta.id}/amr/consensus" : 
                    "${params.outdir}/sample/${meta.id}/variants/consensus" 
            },
            pattern: "*.fa.gz"
        ]    
    }

    // SUBWORKFLOW: AMR
    withName: 'EXTRACT_REGIONS' {
        container = 'public.ecr.aws/o8h2f0o1/corgisnps:1.0'
        publishDir = [ enabled: false ]
    }
    withName: 'SNPEFF_BUILD' {
        container   = 'public.ecr.aws/o8h2f0o1/snpeff:5.4c'
        stageInMode = 'copy'
        publishDir  = [
            path: { "${params.outdir}/species/${meta.species}/snpeff" },
            mode: params.publish_dir_mode,
            pattern: "*.snpeff_db.tar.gz"
        ]
    }
    withName: 'SNPEFF' {
        container   = 'public.ecr.aws/o8h2f0o1/snpeff:5.4c'
        ext.args = ''
        stageInMode = 'copy'
        publishDir = [
            path: { "${params.outdir}/sample/${meta.id}/amr/vcf" },
            pattern: "*.vcf"
        ]
    }
    withName: 'SNPEFF_PARSE' {
        container = 'public.ecr.aws/o8h2f0o1/corgisnps:1.0'
        ext.args = ''
        stageInMode = 'copy'
        publishDir = [ 
            [ path: { "${params.outdir}/sample/${meta.id}/amr/" }, pattern: "variants_full.csv", saveAs: { "${meta.id}.amr-full.csv" } ],
            [ path: { "${params.outdir}/sample/${meta.id}/amr/" }, pattern: "variants_target.csv", saveAs: { "${meta.id}.amr-target.csv" } ] 
        ]
    }


    // SUBWORKFLOW: PHYLO
    withName: 'POLYCORE' {
        container  = 'public.ecr.aws/o8h2f0o1/polycore:1.1.1'
        ext.args   = "--progressive"
        publishDir = [
            [ pattern: 'core.aln.gz',      path: { "${params.outdir}/species/${meta.species}/${meta.subtype}/aln" }, saveAs: { fn -> "${[meta.species, meta.subtype].findAll().join('-')}.aln.gz" } ],
            [ pattern: 'core.full.aln.gz', path: { "${params.outdir}/species/${meta.species}/${meta.subtype}/aln" }, saveAs: { fn -> "${[meta.species, meta.subtype].findAll().join('-')}_full.aln.gz" } ],
            [ pattern: 'full.csv.gz',      path: { "${params.outdir}/species/${meta.species}/${meta.subtype}/aln" }, saveAs: { fn -> "${[meta.species, meta.subtype].findAll().join('-')}_full.csv.gz" } ],
            [ pattern: '*.html',           path: { "${params.outdir}/species/${meta.species}/${meta.subtype}/qc" },  saveAs: { fn -> "${[meta.species, meta.subtype].findAll().join('-')}_cg-plot.html" } ]
        ]
    }
    withName: 'IQTREE' {
        container   = "public.ecr.aws/o8h2f0o1/iqtree3:3.1.3"
        ext.args  = '-m GTR+I+G --seqtype DNA'
        stageInMode = 'copy'
        publishDir  = [ enabled: false, path: { params.outdir } ]
    }

    // WORKFLOW: CorgiSNPs
    withName: SUMMARYLINE {
        container = 'public.ecr.aws/o8h2f0o1/corgisnps:1.0'
        publishDir = [
            path: { "${params.outdir}/sample/${meta.id}" },
            pattern: "*_summary.csv"

        ]
    }
    withName: ADD_AMR {
        container = 'public.ecr.aws/o8h2f0o1/corgisnps:1.0'
        publishDir = [
            path: { "${params.outdir}/sample/${meta.id}" },
            pattern: "*_summary.csv"
        ]
    }
    withName: REPORT_ALL {
        tag       = ''
        container = 'public.ecr.aws/o8h2f0o1/corgisnps:1.0'
        publishDir = [
            path: { "${params.outdir}/" },
            pattern: "CorgiSNPs-summary.csv"
        ]
    }
    withName: REPORT_SPECIES {
        container = 'public.ecr.aws/o8h2f0o1/corgisnps:1.0'
        publishDir = [
            [ pattern: '*.nwk',         path: { "${params.outdir}/species/${meta.species}/${meta.subtype}/tree" } ],
            [ pattern: '*_summary.*',   path: { "${params.outdir}/species/${meta.species}/${meta.subtype}/summary" } ],
            [ pattern: '*_dist.*',      path: { "${params.outdir}/species/${meta.species}/${meta.subtype}/dist" } ],
            [ pattern: '*.microreact',  path: { "${params.outdir}/species/${meta.species}/${meta.subtype}/reports" } ]
        ]
    }
    withName: 'MULTIQC' {
        tag        = ''
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            pattern: 'multiqc_report.html'        
        ]
    }
}